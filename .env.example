# URL base da aplicação (usado para gerar links de pagamento)
# Desenvolvimento:
VITE_PUBLIC_BASE_URL=http://localhost:8080

# Produção (exemplo):
# VITE_PUBLIC_BASE_URL=https://seudominio.com.br

# Variáveis do Supabase (configurar no dashboard do Supabase para Edge Functions)
# SUPABASE_URL=sua_url_aqui
# SUPABASE_ANON_KEY=sua_chave_aqui
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# PagBank (configurar no dashboard do Supabase para Edge Functions)
# NEXT_PUBLIC_APP_URL=https://seudominio.com.br (ou use o mesmo valor de VITE_PUBLIC_BASE_URL)
